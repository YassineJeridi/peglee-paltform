# server/.env.example
NODE_ENV=development
PORT=5001
MONGODB_URI=mongodb://localhost:27017/bac_informatique
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_IN=7d
# URL publique du frontend (CORS + liens des e-mails)
CLIENT_URL=http://localhost:5183
ADMIN_EMAIL=admin@plateforme.tn
ADMIN_PASSWORD=change_this_initial_password

# --- Production ---
# Derrière un reverse proxy (nginx, Traefik, ...) : nombre de proxys (ex. 1)
TRUST_PROXY=
# true : l'API sert aussi client/dist (déploiement monolithique)
SERVE_CLIENT=false

# --- E-mail (mot de passe oublié) : obligatoire en production ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Bac Informatique <no-reply@votre-domaine.tn>"

# --- Exécution du code Python ---
# piston (recommandé en production) | local (développement uniquement) | disabled
CODE_ENGINE=local
PISTON_URL=http://localhost:2000
CODE_TIMEOUT_MS=5000
